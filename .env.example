# ── Database ─────────────────────────────────────────────
# Leave empty for local dev: `npm run dev` starts an embedded Postgres (PGlite) stored in ./.pglite
# Production: paste your Neon connection string (pooled URL is fine)
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me
# Comma-separated emails that get admin access when they log in
ADMIN_EMAILS=you@example.com
# Google login (optional). In Google Cloud Console add redirect URIs:
#   http://localhost:3000/api/auth/google/callback and https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email OTP delivery (https://resend.com). Without it, codes print in the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM="VedicVisa <hello@yourdomain.in>"

# ── Razorpay ─────────────────────────────────────────────
# Without keys (dev only) checkout uses a test "mock payment" button.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping webhooks (future Shiprocket etc.) ───────────
SHIPPING_WEBHOOK_SECRET=

# ── Images ───────────────────────────────────────────────
# Cloudflare R2 (free: 10 GB). Without these, uploads go to ./public/uploads (dev only).
# R2_PUBLIC_URL should be a custom domain on the bucket (e.g. https://media.vedicvisa.com) so it's served through Cloudflare's CDN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin subdomain (production) ─────────────────────────
# Read at BUILD time (npm run cf:build defaults it to admin.vedicvisa.com). Leave empty locally.
ADMIN_HOST=
# Share the login between vedicvisa.com and admin.vedicvisa.com
COOKIE_DOMAIN=

# Dev only: lets checkout simulate payments when Razorpay keys are missing. Never set in production.
ALLOW_MOCK_PAYMENTS=
