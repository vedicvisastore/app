# Copy to .env.production (git-ignored), fill in, then tell Claude "filled".
# Claude uploads these to Cloudflare as encrypted secrets with `wrangler secret bulk` without printing them.

# Neon → your project → Connection string → "Pooled connection"
DATABASE_URL=

# Generated for you by Claude (leave as is)
AUTH_SECRET=

# Who can open the admin (comma-separated emails)
ADMIN_EMAILS=

# Razorpay → Settings → API keys. Start with TEST keys (rzp_test_...), switch to live after testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → secret you choose (can fill after first deploy)
RAZORPAY_WEBHOOK_SECRET=

# Resend → API keys → create a NEW key (the old one leaked)
RESEND_API_KEY=
EMAIL_FROM=VedicVisa <hello@vedicvisa.com>

# Google Cloud → Credentials → create a NEW OAuth client (the old secret leaked)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare → R2 → Manage API tokens → Create token (Object Read & Write, bucket vedicvisa-media)
R2_ACCOUNT_ID=e3041247576460aba3e75218a15bbde7
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vedicvisa-media
R2_PUBLIC_URL=https://media.vedicvisa.com

# Upstash Redis (REST). Optional: without it, rate limits fall back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
