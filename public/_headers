# Cloudflare Workers static assets: browser caching for files that never change in place.
# Build files have a content hash in their name, so they can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand pictures (logo, paintings, banner scenes): a week in the browser, refreshed in the background after.
# Swapped pictures from the visual editor get new URLs on media.vedicvisa.com, so they never go stale.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
